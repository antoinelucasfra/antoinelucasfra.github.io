# .gitignore for R / Quarto project
# Keep sources, lockfiles, and the rendered site tracked; ignore caches and
# local environments.

# Python / local tooling
.venv/
**/.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# R / RStudio
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
*.bak

# renv (library, staging, sandbox and the rest are ignored by renv/.gitignore;
# renv.lock and the renv/ scaffolding are tracked)

# Quarto / rendering caches and temp files
.quarto/
.quarto-cache/
_quarto/

# Quarto freeze cache. Freely reusable chunks are committed so CI and fresh
# clones do not re-execute them.
_freeze/*
!_freeze/posts/
!_freeze/site_libs/

# Render intermediates written beside the sources by single-file or interrupted
# renders.
*-listing.json
*.feed-*-staged
/site_libs/
*.html
*.pdf

# Render output is committed: `quarto render` writes docs/, and CI uploads that
# directory as the Pages artifact. Re-include the generated pages and CV PDFs.
!docs/**/*.html
!docs/**/*.pdf

# Local scratch / exploration notes
explore/

# OS / editor
.DS_Store
Thumbs.db
.idea/

**/*.quarto_ipynb

/.quarto/
_test_listing_files/
