# .gitignore for R / Quarto project
# Keep source files and lockfiles tracked; ignore rendered output, caches, and local environments

# Python / local tooling
.venv/
**/.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# R / RStudio
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
*.bak

# rv (project library ignored via rv/.gitignore; rproject.toml + rv.lock tracked)

# Quarto / rendering caches and temp files
.quarto/
.quarto-cache/
_quarto/
docs/

# Quarto freeze cache. Freely reusable chunks are committed so CI and fresh
# clones do not re-execute them. The catalog is excluded on purpose: its chunk
# writes catalog/resources-items.yml as a side effect, and a frozen chunk on a
# fresh checkout would skip that write and leave the listing with no source.
_freeze/*
!_freeze/posts/
!_freeze/site_libs/

# Render intermediates written beside the sources by single-file or interrupted
# renders. Published copies live in docs/.
*-listing.json
*.feed-*-staged
/site_libs/
*.html
*.pdf

# Generated listing source (rebuilt at render from catalog/resources.txt)
catalog/resources-items.yml

# Local scratch / exploration notes
explore/

# OS / editor
.DS_Store
Thumbs.db
.idea/

**/*.quarto_ipynb

/.quarto/
_test_listing_files/
