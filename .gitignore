# .gitignore for R / Quarto project
# Keep source files and lockfiles tracked; ignore rendered output, caches, and local environments

# Python / local tooling
.venv/
**/.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# R / RStudio
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
*.bak

# renv (keep lockfile and activate script, ignore installed libraries)
renv/library/
renv/staging/
renv/python/
renv/cache/

# Quarto / rendering caches and temp files
.quarto/
.quarto-cache/
_quarto/
docs/

# Quarto freeze (generated/temporary files)
_freeze/

# OS / editor
.DS_Store
Thumbs.db
.idea/

**/*.quarto_ipynb

/sandbox/**
!/sandbox/gen_descriptions.py
